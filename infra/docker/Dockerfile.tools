# AI-Pentest Copilot - Isolated Pentest Tools Sandbox Container
# Multi-arch base image with pre-installed assessment tools

FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install foundational utilities and core CLI assessment tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    python3-venv \
    nmap \
    masscan \
    nikto \
    whatweb \
    testssl.sh \
    theharvester \
    smbclient \
    snmp \
    ldap-utils \
    default-mysql-client \
    dnsutils \
    net-tools \
    iputils-ping \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install ProjectDiscovery and Go-based binaries
ENV GOPATH=/root/go
ENV PATH=$PATH:/root/go/bin:/usr/local/bin

RUN wget -q https://github.com/projectdiscovery/httpx/releases/download/v1.6.8/httpx_1.6.8_linux_amd64.zip -O /tmp/httpx.zip && \
    unzip -q /tmp/httpx.zip -d /usr/local/bin/ httpx && \
    chmod +x /usr/local/bin/httpx && \
    rm -f /tmp/httpx.zip || true

RUN wget -q https://github.com/projectdiscovery/nuclei/releases/download/v3.3.5/nuclei_3.3.5_linux_amd64.zip -O /tmp/nuclei.zip && \
    unzip -q /tmp/nuclei.zip -d /usr/local/bin/ nuclei && \
    chmod +x /usr/local/bin/nuclei && \
    rm -f /tmp/nuclei.zip || true

RUN wget -q https://github.com/projectdiscovery/katana/releases/download/v1.1.0/katana_1.1.0_linux_amd64.zip -O /tmp/katana.zip && \
    unzip -q /tmp/katana.zip -d /usr/local/bin/ katana && \
    chmod +x /usr/local/bin/katana && \
    rm -f /tmp/katana.zip || true

RUN wget -q https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_linux_amd64.tar.gz -O /tmp/ffuf.tar.gz && \
    tar -xzf /tmp/ffuf.tar.gz -C /usr/local/bin/ ffuf && \
    chmod +x /usr/local/bin/ffuf && \
    rm -f /tmp/ffuf.tar.gz || true

RUN wget -q https://github.com/OJ/gobuster/releases/download/v3.6.0/gobuster_Linux_x86_64.tar.gz -O /tmp/gobuster.tar.gz && \
    tar -xzf /tmp/gobuster.tar.gz -C /usr/local/bin/ gobuster && \
    chmod +x /usr/local/bin/gobuster && \
    rm -f /tmp/gobuster.tar.gz || true

RUN wget -q https://github.com/RustScan/RustScan/releases/download/2.3.0/rustscan-2.3.0-x86_64-linux.zip -O /tmp/rustscan.zip && \
    unzip -q /tmp/rustscan.zip -d /tmp/rustscan_extract && \
    mv /tmp/rustscan_extract/rustscan /usr/local/bin/rustscan 2>/dev/null || true && \
    chmod +x /usr/local/bin/rustscan 2>/dev/null || true && \
    rm -rf /tmp/rustscan.zip /tmp/rustscan_extract || true

WORKDIR /workspace

# Default command: display toolset verification matrix
CMD ["echo", "AI-Pentest Copilot Tools Sandbox Container Ready"]
