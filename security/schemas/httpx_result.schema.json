{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HttpxResult",
  "description": "Schema for structured Httpx HTTP probe results",
  "type": "object",
  "required": ["scan_metadata", "results"],
  "properties": {
    "scan_metadata": {
      "type": "object",
      "required": ["tool", "target", "command", "timestamp", "exit_code"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status_code"],
        "properties": {
          "url": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "scheme": {
            "type": "string"
          },
          "status_code": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "webserver": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "content_length": {
            "type": "integer"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_headers": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
