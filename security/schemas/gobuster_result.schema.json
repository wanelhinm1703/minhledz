{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GobusterResult",
  "description": "Schema for structured Gobuster directory/file discovery results",
  "type": "object",
  "required": [
    "scan_metadata",
    "entries"
  ],
  "properties": {
    "scan_metadata": {
      "type": "object",
      "required": [
        "tool",
        "target",
        "command",
        "timestamp",
        "exit_code"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "redirect_to": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}