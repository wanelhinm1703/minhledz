{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MasscanResult",
  "description": "Schema for structured Masscan port discovery results",
  "type": "object",
  "required": ["scan_metadata", "hosts"],
  "properties": {
    "scan_metadata": {
      "type": "object",
      "required": ["tool", "target", "command", "timestamp", "exit_code"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        },
        "rate": {
          "type": "integer"
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ip", "ports"],
        "properties": {
          "ip": {
            "type": "string"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port", "proto", "status"],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "proto": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "ttl": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
