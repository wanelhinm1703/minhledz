{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceEnumResult",
  "description": "Schema for structured Service Enumeration (SMB, SNMP, LDAP, Database) results",
  "type": "object",
  "required": ["scan_metadata", "service", "findings"],
  "properties": {
    "scan_metadata": {
      "type": "object",
      "required": ["tool", "target", "command", "timestamp", "exit_code"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "service": {
      "type": "string"
    },
    "target_port": {
      "type": "integer"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "description"],
        "properties": {
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high"]
          }
        }
      }
    },
    "shares": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
