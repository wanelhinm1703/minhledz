{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NucleiFinding",
  "description": "Schema for structured Nuclei scan findings",
  "type": "object",
  "required": [
    "scan_metadata",
    "findings"
  ],
  "properties": {
    "scan_metadata": {
      "type": "object",
      "required": [
        "tool",
        "target",
        "command",
        "timestamp",
        "exit_code"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number"
        },
        "exit_code": {
          "type": "integer"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "template_id",
          "info",
          "matched_at"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          },
          "info": {
            "type": "object",
            "required": [
              "name",
              "severity"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical",
                  "unknown"
                ]
              },
              "description": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reference": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cve_id": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwe_id": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cvss_score": {
                "type": "number"
              }
            }
          },
          "type": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "matched_at": {
            "type": "string"
          },
          "extracted_results": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "curl_command": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}